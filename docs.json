{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PGBen",
  "description": "Documentação operacional para quem usa o PGBen em produção. Trilhas por papel, fluxos do sistema, changelog e suporte.",
  "colors": {
    "primary": "#137f93",
    "light": "#26a7be",
    "dark": "#106b7a"
  },
  "favicon": "/logo/light.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Início",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Trilhas",
          "icon": "route",
          "href": "/trilhas/visao-geral"
        },
        {
          "anchor": "Changelog",
          "icon": "history",
          "href": "/changelog/ultimas-entregas"
        },
        {
          "anchor": "Suporte",
          "icon": "life-buoy",
          "href": "/suporte/troubleshooting"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Para começar",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "comecar/introducao",
          "comecar/primeiros-passos",
          "comecar/glossario"
        ]
      },
      {
        "group": "Trilhas de leitura",
        "icon": "route",
        "expanded": true,
        "pages": [
          "trilhas/visao-geral",
          "trilhas/operador",
          "trilhas/gestor",
          "trilhas/administrador",
          "trilhas/fornecedor",
          "trilhas/suporte"
        ]
      },
      {
        "group": "Operação",
        "icon": "workflow",
        "expanded": true,
        "pages": [
          "operacao/beneficiarios",
          "operacao/solicitacoes",
          "operacao/concessoes-pagamentos",
          "operacao/monitoramento"
        ]
      },
      {
        "group": "Gestão",
        "icon": "settings",
        "expanded": true,
        "pages": [
          "gestao/administracao",
          "gestao/oficios",
          "gestao/relatorios-downloads"
        ]
      },
      {
        "group": "Fornecedor",
        "icon": "handshake",
        "expanded": true,
        "pages": [
          "gestao/fornecedor"
        ]
      },
      {
        "group": "Changelog",
        "icon": "history",
        "expanded": true,
        "pages": [
          "changelog/ultimas-entregas"
        ]
      },
      {
        "group": "Suporte",
        "icon": "life-buoy",
        "expanded": true,
        "pages": [
          "suporte/faq",
          "suporte/troubleshooting"
        ]
      },
      {
        "group": "Publicação",
        "icon": "badge-check",
        "expanded": false,
        "pages": [
          "producao/checklist-publicacao",
          "producao/screenshots"
        ]
      },
      {
        "group": "Apêndice",
        "icon": "book-marked",
        "expanded": false,
        "pages": [
          "apendice/indice-remissivo",
          "sumario"
        ]
      }
    ]
  },
  "logo": "/logo/light.png",
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Acessar PGBen",
      "href": "https://semtas-natal.pgben.com.br"
    }
  },
  "footer": {
    "socials": {}
  },
  "search": {
    "prompt": "Pesquise ou pergunte"
  },
  "api": {
    "openapi": "https://api-semtas-natal.pgben.com.br/openapi.json"
  }
}
