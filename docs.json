{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PGBen",
  "description": "Documentação para quem opera o sistema todos os dias. Cadastro, análise, concessão, pagamento, monitoramento.",
  "colors": {
    "primary": "#137f93",
    "light": "#26a7be",
    "dark": "#106b7a"
  },
  "favicon": "/logo/light.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Início",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Sumário",
          "icon": "list",
          "href": "/sumario"
        },
        {
          "anchor": "Suporte",
          "icon": "life-buoy",
          "href": "/suporte/troubleshooting"
        }
      ]
    },
    "directory": "card",
    "groups": [
      {
        "group": "Para começar",
        "icon": "rocket",
        "expanded": true,
        "pages": [
          "comecar/introducao",
          "comecar/primeiros-passos",
          "comecar/glossario"
        ]
      },
      {
        "group": "Operação",
        "icon": "workflow",
        "expanded": true,
        "pages": [
          "operacao/beneficiarios",
          "operacao/solicitacoes",
          "operacao/concessoes-pagamentos",
          "operacao/monitoramento"
        ]
      },
      {
        "group": "Gestão",
        "icon": "settings",
        "expanded": true,
        "pages": [
          "gestao/administracao",
          "gestao/relatorios-downloads",
          "gestao/fornecedor"
        ]
      },
      {
        "group": "Suporte",
        "icon": "life-buoy",
        "expanded": true,
        "pages": [
          "suporte/faq",
          "suporte/troubleshooting"
        ]
      },
      {
        "group": "Apêndice",
        "icon": "book-marked",
        "expanded": false,
        "pages": [
          "apendice/indice-remissivo",
          "sumario"
        ]
      }
    ]
  },
  "logo": "/logo/light.png",
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Acessar PGBen",
      "href": "https://semtas-natal.pgben.com.br"
    }
  },
  "footer": {
    "socials": {}
  },
  "search": {
    "prompt": "Pesquise ou pergunte"
  },
  "api": {
    "openapi": "https://dev-api-semtas-natal.pgben.com.br/openapi.json"
  },
  "banner": {
    "content": "Documentação em desenvolvimento. Algumas informações podem estar desatualizadas ou incorretas."
  }
}
